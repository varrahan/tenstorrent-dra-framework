{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "deviceRoot", "sysfsRoot", "pciSysfsRoot", "stateDir", "cdiDir"],
  "properties": {
    "image": {"type": "object", "required": ["repository", "tag"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string", "minLength": 1}, "pullPolicy": {"type": "string"}}},
    "interval": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"},
    "deviceRoot": {"type": "string", "pattern": "^/"},
    "sysfsRoot": {"type": "string", "pattern": "^/"},
    "pciSysfsRoot": {"type": "string", "pattern": "^/"},
    "stateDir": {"type": "string", "pattern": "^/"},
    "cdiDir": {"type": "string", "pattern": "^/"}
  }
}
